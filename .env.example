# LLDAP: copy this file to .env, then fill in your actual values.
LDAP_SERVER_ADDRESS=
# LDAPS: on_connect + your LDAPS port (commonly 6360).
# Plain LDAP on a trusted private network: insecure + 3890.
# Use before_bind only if your endpoint supports StartTLS.
LDAP_TLS_STRATEGY=on_connect
LDAP_SERVER_PORT=6360
# Example: ou=people,dc=example,dc=com
LDAP_USER_SEARCH_BASE=
LDAP_USER_ATTRIBUTE=uid
LDAP_USER_DN_ATTRIBUTE=uid
# Example: uid=jupyterhub-service,ou=people,dc=example,dc=com
# Create a service user in LLDAP's lldap_strict_readonly group.
LDAP_BIND_DN=
# Single-quote passwords containing $ or #.
LDAP_BIND_PASSWORD=
# Optional group restriction, e.g. '["cn=jupyterhub-users,ou=groups,dc=example,dc=com"]'
LDAP_ALLOWED_GROUPS=[]
# DN of the LDAP group whose members get the JupyterHub admin flag.
# Independent of LDAP_ALLOWED_GROUPS: leave empty until the group exists in
# LLDAP; empty means no one is admin.
# Example: cn=jupyterhub-admins,ou=groups,dc=example,dc=com
LDAP_ADMIN_GROUP=
# CA file path INSIDE Hub. Drop the PEM file in hub/certs/ (mounted read-only
# at /etc/jupyterhub-certs by compose.yaml) and point this at it, e.g.
# /etc/jupyterhub-certs/islab-ca.crt
LDAP_CA_CERT_FILE=

# Which host interface the Hub's port (host-side 9000, see compose.yaml)
# binds to. Leave as 127.0.0.1 for a dev sandbox with no reverse proxy.
# In production, set this to the host's LAN IP so an external reverse
# proxy (e.g. a shared Caddy on a different machine, terminating TLS with
# your own internal CA) can actually reach it -- 127.0.0.1 only accepts
# connections from this host itself.
HUB_BIND_ADDRESS=127.0.0.1

# The real public domain users reach this deployment through (e.g. behind
# the shared Caddy reverse proxy). Baked into the user-image at BUILD time
# (docker compose --profile build build user-image), not read live -- it's
# used by ops/dsh-trusted-origin/patch-trusted-hostname.mjs to let dsh's own
# Settings/Credentials pages work from this domain instead of only
# 127.0.0.1/localhost (see STATUS.md for why that's safe here). Leave empty
# to skip the patch; those pages just stay disabled, same as unpatched dsh.
DSH_PUBLIC_HOSTNAME=dsh-hub.islab.local

# Shared secret between hub/jupyterhub_config.py's service registration and
# the panel container. Generate with `openssl rand -hex 32`. Required --
# compose.yaml refuses to start any service if this is empty.
PANEL_API_TOKEN=
# Spark's OpenAI-compatible vLLM endpoint.
SPARK_BASE_URL=http://192.168.101.70:8888/v1
# How many requests the Dispatcher forwards to Spark at once. Editable live
# from the Panel (admin only) after startup.
DISPATCHER_CONCURRENCY=1
# Default per-user container CPU (cores)/memory (MB) limit, applied to any
# user who doesn't have a custom limit set. Editable per-user live from the
# Panel (admin only); a new custom limit for a user overrides these defaults.
# 3072MB sized for a 40GB-RAM host VM shared with ~10 (up to 15) concurrent
# users: 15 users maxed out simultaneously = 45GB, over budget on paper,
# but real usage rarely sits at the ceiling and the host VM should also
# have swap as an OOM safety net -- see README's Proxmox VM sizing notes.
DEFAULT_CPU_CORES=2.0
DEFAULT_MEMORY_MB=3072
# Same, but for disk (see ops/disk-quota/apply-disk-quotas.sh -- this one
# is not applied live by Panel, only recorded for the reconciler script).
DEFAULT_DISK_MB=10240
# hub/idle_culler.py: auto-stop a user's server after this many minutes with
# no proxied HTTP traffic AND no in-flight/queued Dispatcher request (see
# STATUS.md) -- shutdown_on_logout is intentionally False, so without this a
# forgotten server just runs forever. 120min is a starting guess, not a
# measured value; tune it once real usage patterns are known.
IDLE_CULL_TIMEOUT_MINUTES=120
IDLE_CULL_CHECK_INTERVAL_MINUTES=15
